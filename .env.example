# Copy to .env (git-ignored) and fill in. Only needed for the optional SiYuan mirror.

# SiYuan server, e.g. http://localhost:6806 or a public hostname
SIYUAN_URL=

# SiYuan: Settings → About → API token
SIYUAN_TOKEN=

# Only if SiYuan sits behind Cloudflare Access: a service token, allowed by a "Service Auth" policy
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
